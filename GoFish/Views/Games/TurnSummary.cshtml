<html>
  <head>
    <title>Go Fish</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.0/css/bootstrap.min.css" integrity="sha384-9aIt2nRpC12Uk9gS9baDl411NQApFmC26EwAOH8WgZl5MYYxFfc+NcPb1dKGj7Sk" crossorigin="anonymous">
  </head>
  <body>
    <h1>You and the Computer took these actions:</h1>
    <h2>You asked for @ViewBag.PlayerAskedCardValue</h2>
    @if (ViewBag.PlayerDrawnCardResult)
    {
      <h2>The computer handed you their @ViewBag.PlayerAskedCardValue</h2>
    }
    else
    {
      <h2>The computer didn't have any @ViewBag.PlayerAskedCardValue. You drew from the deck.</h2>
    }
    <h2>The Computer asked for @ViewBag.ComputerAskedCardValue</h2>
    @if (ViewBag.ComputerDrawnCardResult)
    {
      <h2>You handed the computer your @ViewBag.ComputerAskedCardValue</h2>
    }
    else
    {
      <h2>You didn't have any @ViewBag.ComputerAskedCardValue. The computer drew from the deck.</h2>
    }

    <br>
    <form action="/games">
      <button type="submit" name="button">Your turn!</button>
    </form>
  </body>
</html>
