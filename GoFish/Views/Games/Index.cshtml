<!DOCTYPE html>
<html>
  <head>
    <title>Go Fish</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.0/css/bootstrap.min.css" integrity="sha384-9aIt2nRpC12Uk9gS9baDl411NQApFmC26EwAOH8WgZl5MYYxFfc+NcPb1dKGj7Sk" crossorigin="anonymous">
  </head>
  <body>
    @using GoFish.Models;

    <h1>Your Hand</h1>
    @foreach (Card card in Model.PlayerObject.PlayerHand)
    {
      <form action="/games/ask-card" method="post">
        <input name="cardValue" type="text" value="@card.Value" hidden>
        <input name="cardSuit" type="text" value="@card.Suit" hidden>
        <button type="submit" name="button">@card.Value of @card.Suit</button>
      </form>
    }
  </body>
  </html>