<!DOCTYPE html>
<html>
  <head>
    <title>Go Fish</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.0/css/bootstrap.min.css" integrity="sha384-9aIt2nRpC12Uk9gS9baDl411NQApFmC26EwAOH8WgZl5MYYxFfc+NcPb1dKGj7Sk" crossorigin="anonymous">
  </head>
  <body>
    <h1>The computer is thinking...</h1>
    <script>
      let cardSuit = '@ViewBag.CardSuit';
      const turnSummaryURL = '@Url.Action("turn-summary", "games")' + '?cardSuit=' + encodeURIComponent(cardSuit);
      setTimeout(() => {
        window.location.href = turnSummaryURL;
      }, "5000")
    </script>
  </body>
</html>