<!DOCTYPE html>
<html>
  <head>
    <title>Go Fish</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.0/css/bootstrap.min.css" integrity="sha384-9aIt2nRpC12Uk9gS9baDl411NQApFmC26EwAOH8WgZl5MYYxFfc+NcPb1dKGj7Sk" crossorigin="anonymous">
  </head>
  <body>
    <h1>The computer is thinking...</h1>
    <script>
      let computerCardValue = '@ViewBag.ComputerAskedCardValue';
      let playerCardValue = '@ViewBag.PlayerAskedCardValue';
      let playerDrawnCard = '@ViewBag.PlayerDrawnCardResult';
      let computerDrawnCard = '@ViewBag.ComputerDrawnCardResult';
      const turnSummaryURL = '@Url.Action("turn-summary", "games")' + '?computerCardValue=' + encodeURIComponent(computerCardValue) + '&playerCardValue=' + encodeURIComponent(playerCardValue) + '&computerDrawnCard=' + encodeURIComponent(computerDrawnCard) + '&playerDrawnCard=' + encodeURIComponent(playerDrawnCard);
      setTimeout(() => {
        window.location.href = turnSummaryURL;
      }, "1500")
    </script>
  </body>
</html>